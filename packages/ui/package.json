{
  "name": "@tnotesjs/ui",
  "version": "0.3.3",
  "description": "Shared Vue UI for TNotes built-in blocks — consumed by the TNotes SSG and Desk.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./footprints-parse": {
      "types": "./src/components/Footprints/parse.ts",
      "node": "./dist/components/Footprints/parse.js",
      "import": "./src/components/Footprints/parse.ts",
      "default": "./src/components/Footprints/parse.ts"
    },
    "./mindmap-parse": {
      "types": "./src/components/Mindmap/markdown.ts",
      "node": "./dist/components/Mindmap/markdown.js",
      "import": "./src/components/Mindmap/markdown.ts",
      "default": "./src/components/Mindmap/markdown.ts"
    },
    "./image-markdown": {
      "types": "./src/markdown/image.ts",
      "node": "./dist/markdown/image.js",
      "import": "./src/markdown/image.ts",
      "default": "./src/markdown/image.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/prose.css": "./src/styles/prose.css",
    "./styles/code.css": "./src/styles/code.css",
    "./styles/swiper.css": "./src/styles/swiper.css",
    "./swiper": {
      "types": "./src/swiper/hydrate.ts",
      "import": "./src/swiper/hydrate.ts",
      "default": "./src/swiper/hydrate.ts"
    },
    "./code": {
      "types": "./src/code/highlight.ts",
      "node": "./dist/code/highlight.js",
      "import": "./src/code/highlight.ts"
    },
    "./code-block": "./src/components/CodeBlock/CodeBlock.vue",
    "./code-group": "./src/components/CodeGroup/CodeGroup.vue",
    "./badge": "./src/components/Badge/Badge.vue",
    "./image-preview": "./src/components/ImagePreview/ImagePreview.vue",
    "./bilibili-video": "./src/entries/bilibili-video.ts",
    "./footprints": "./src/entries/footprints.ts",
    "./mermaid": "./src/entries/mermaid.ts",
    "./mindmap": "./src/entries/mindmap.ts",
    "./notes-table": "./src/entries/notes-table.ts",
    "./word-list": "./src/entries/word-list.ts",
    "./excalidraw-view": {
      "types": "./src/entries/excalidraw-view.ts",
      "import": "./src/entries/excalidraw-view.ts",
      "default": "./src/entries/excalidraw-view.ts"
    },
    "./excalidraw-editor": {
      "types": "./src/entries/excalidraw-editor.ts",
      "import": "./src/entries/excalidraw-editor.ts",
      "default": "./src/entries/excalidraw-editor.ts"
    },
    "./mindmap-editor": {
      "types": "./src/entries/mindmap-editor.ts",
      "import": "./src/entries/mindmap-editor.ts",
      "default": "./src/entries/mindmap-editor.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@tnotesjs/mindmap-core": "workspace:^",
    "marked": "^15.0.11",
    "mermaid": "^11.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.90.0",
    "shiki": "4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnotesjs/tnotes.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/tnotesjs/tnotes/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/tnotesjs/tnotes/issues"
  },
  "keywords": [
    "tnotesjs",
    "vue",
    "ssg",
    "desk"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup src/code/highlight.ts src/components/Footprints/parse.ts src/components/Mindmap/markdown.ts src/markdown/image.ts --format esm --dts --out-dir dist --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build"
  }
}
